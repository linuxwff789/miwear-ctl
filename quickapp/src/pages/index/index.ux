  flex-direction: column;
  width: 480px;
  height: 480px;
  padding: 16px;
  background-color: #000000;
}

.card {
  flex-direction: column;
  padding: 14px;
  margin-bottom: 12px;
  border-radius: 12px;
  background-color: #1c1c1e;
}

.center {
  align-items: center;
  justify-content: center;
}

.title {
  font-size: 34px;
  color: #ffffff;
  font-weight: bold;
}

.sub {
  font-size: 20px;
  color: #8e8e93;
  margin-top: 6px;
}

.counter {
  font-size: 72px;
  color: #ffa626;
  font-weight: bold;
}

.hint {
  font-size: 18px;
  color: #8e8e93;
}

.row {
  flex-direction: row;
  justify-content: space-between;
  margin-bottom: 12px;
}

.btn {
  flex: 1;
  height: 76px;
  margin: 0 6px;
  align-items: center;
  justify-content: center;
  border-radius: 14px;
  background-color: #2c2c2e;
}

.primary {
  background-color: #ffa626;
}

.btn-text {
  font-size: 24px;
  color: #ffffff;
}
</style>
