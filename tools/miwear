# 启动手表联网网关（手机侧跑 libnetproxy.so，把 ch7 的 IP 包做 NAT）
#   miwear net [--launch <包名> [uri]]   可选：同时拉起手表上的应用
cmd_net() {
  local lp="" lu=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --launch) lp=${2:-}; shift 2 ;;
      *) [ -n "$lp" ] && [ -z "$lu" ] && lu=$1; shift ;;
    esac
  done
  ensure_key; need_root; need_app
  su -c "dumpsys deviceidle whitelist +$PKG" >/dev/null 2>&1
  su -c "am set-standby-bucket $PKG active" >/dev/null 2>&1

  # 常驻服务在跑 → 直接 socket（网关在服务进程里跑，不会被冻结）
  if serve_up; then
    if rpc_send "$(okjson cmd=net launch_pkg="$lp" launch_uri="$lu")" 90; then
      sleep 1
      ok "联网网关已启动（常驻服务内运行）"
      info "手表端发起请求后，用 miwear log -f 看 ch7 流量"
      return 0
    fi
    warn "RPC 启动失败，回退 Intent 模式"
  fi

  local run="$$-$RANDOM"
  su -c "am force-stop com.mi.health; am force-stop $PKG" 2>/dev/null
  sleep 1
  if [ -n "$lp" ] && [ -n "$lu" ]; then
    launch_app --es run_id "$run" --ez netproxy true --es launch_pkg "$lp" --es launch_uri "$lu"
  elif [ -n "$lp" ]; then
    launch_app --es run_id "$run" --ez netproxy true --es launch_pkg "$lp"
  else
    launch_app --es run_id "$run" --ez netproxy true
  fi
  wait_for "RUN $run" 25 || { warn "App 没起来"; log_dump; return 1; }
  if wait_for "netproxy 已启动|libnetproxy.so 未加载" 40; then
    log_dump | tail -8
    ok "联网网关已启动（保持连接中）"
    info "手表端发起请求后，用 miwear log 看 ch7 流量"
  else
    warn "启动失败"; log_dump; return 1
  fi
}

# ──────── auth key（从官方 App 数据库自动读）────────
save_config() { mkdir -p "$(dirname "$CONF")"; { echo "MAC=$MAC"; echo "KEY=$KEY"; echo "REPO=$REPO"; echo "PORT=$PORT"; } > "$CONF"; }

# 读官方 App 的 device 表；输出: mac \t key \t model \t name \t phone_id（失败/无则输出空或 NONE）
read_key_from_db() {
  local dbdir=$HOME/.miwear-tmp
  mkdir -p "$dbdir"
  su -c "rm -f $dbdir/device_db*; cp /data/data/com.mi.health/databases/device_db* $dbdir/ 2>/dev/null; chmod 666 $dbdir/device_db* 2>/dev/null"
  [ -f "$dbdir/device_db" ] || { echo NODB; return 0; }
  # 顺手把原件导给 App —— App 进程里往往看不到 su（mount namespace 里没 su），
  # 没法自己读官方库，只能读我们放进去的文件。
  if su -c "test -d /data/data/$PKG/files" 2>/dev/null; then
    su -c "cp -f $dbdir/device_db /data/data/$PKG/files/device_db.official 2>/dev/null; chmod 666 /data/data/$PKG/files/device_db.official 2>/dev/null"
  fi
  MIWEAR_MAC="${MAC:-}" python3 - "$dbdir/device_db" <<'PY'
import sqlite3,json,sys,os
p=sys.argv[1]; want=os.environ.get('MIWEAR_MAC','').upper()
c=sqlite3.connect(p)
cols=[r[1] for r in c.execute('PRAGMA table_info(device)')]
found=[]
for row in c.execute('select * from device'):
    r=dict(zip(cols,row))
    for col in ('detail','extraValues'):
        s=r.get(col) or ''
        if 'encrypt_key' not in s: continue
        try: j=json.loads(s)
        except Exception: continue
        k=j.get('encrypt_key')
        if k: found.append((j.get('mac',''),k,r.get('model',''),(r.get('name') or '').strip(),j.get('phone_id','')))
if not found:
    print('NONE'); raise SystemExit
pick=next((f for f in found if f[0].upper()==want), found[0])
print('%s\t%s\t%s\t%s\t%s' % pick)
PY
}

# 把官方 key 导出给 App（写 3 行：mac / key / phone_id）
export_key_to_app() {  # mac key phone_id
  local appdir=/data/data/$PKG/files
  su -c "test -d $appdir" 2>/dev/null || return 0
  local tmp=$HOME/.miwear-tmp/official_key.txt
  { echo "${1:-}"; echo "${2:-}"; echo "${3:-}"; } > "$tmp"
  su -c "cp -f $tmp $appdir/official_key.txt && chmod 666 $appdir/official_key.txt" 2>/dev/null
}

# 从已配对设备里猜手表 MAC
detect_mac() {
  su -c "dumpsys bluetooth_manager" 2>/dev/null | sed -n '/Bonded devices/,/AdapterState/p' \
    | grep -iE "watch|手环|手表" | grep -oiE "([0-9a-f]{2}:){5}[0-9a-f]{2}" | head -1
}

# 没配置时自动推导 auth key（及 MAC）
ensure_key() {
  [ -n "${MAC:-}" ] || MAC=$(detect_mac)
  if [ -n "${KEY:-}" ]; then
    # 保证 App 也能读到 key（App 进程里常常看不到 su）
    if ! su -c "test -s /data/data/$PKG/files/official_key.txt" 2>/dev/null; then
      export_key_to_app "${MAC:-}" "$KEY" ""
    fi
    return 0
  fi
  need_root
  local out; out=$(read_key_from_db)
  case "$out" in
    NODB|NONE|"") die "没找到 auth key。手动创建 $CONF（MAC=/KEY=），或跑 miwear key 看看原因" ;;
  esac
  local dmac dkey dmodel dname dpid
  IFS=$'\t' read -r dmac dkey dmodel dname dpid <<< "$out"
  [ -n "${MAC:-}" ] || MAC=$dmac
  KEY=$dkey
  export_key_to_app "$dmac" "$dkey" "$dpid"
  info "已自动获取 auth key（来自小米运动健康数据库）"
  save_config
}

cmd_key() {
  need_root
  case "${1:-}" in
    --set)
      local k=${2:-}
      [ -n "$k" ] || die "用法: miwear key --set <32位hex>"
      k=$(printf '%s' "$k" | tr -d '[:space:]:-' | tr 'A-F' 'a-f')
      [ ${#k} -eq 32 ] || die "auth key 必须是 32 位 hex（16 字节），你给的是 ${#k} 位"
      KEY=$k; save_config; export_key_to_app "${MAC:-}" "$KEY" ""
      ok "已手动写入 $CONF（KEY=$KEY）"; return 0 ;;
  esac
  local save=0
  [ "${1:-}" = "--save" ] && save=1
  [ -n "${MAC:-}" ] || MAC=$(detect_mac)
  local out; out=$(read_key_from_db)
  case "$out" in
    NODB) die "读不到小米运动健康的 device_db（App 装了吗？）" ;;
    NONE|"") die "数据库里没找到 encrypt_key" ;;
  esac
  local mac key model name pid
  IFS=$'\t' read -r mac key model name pid <<< "$out"
  export_key_to_app "$mac" "$key" "$pid"
  ok "auth key = $key"
  info "手表：$name ($model)   MAC=$mac   phone_id=$pid"
  [ "${mac^^}" = "${MAC^^}" ] || warn "配置里的 MAC ($MAC) 与数据库 ($mac) 不一致"
  if [ $save -eq 1 ]; then MAC=$mac; KEY=$key; save_config; ok "已写入 $CONF"
  else info "加 --save 可写入 $CONF；也可 miwear key --set <hex> 手动指定"; fi
}

# 从官方数据库里读 phone_id（重绑生成 appDeviceId 要用）
read_phone_id() {
  local out; out=$(read_key_from_db)
  case "$out" in NODB|NONE|"") echo ""; return 0 ;; esac
  local a b c d pid
  IFS=$'\t' read -r a b c d pid <<< "$out"
  echo "$pid"
}

# ───────── 本地绑定（自造 auth key，不依赖官方 App）─────────
#   miwear bind --probe            只查手表是否允许本地绑定（安全，不改任何东西）
#   miwear bind --yes [--userid N] [--phoneid X]   真正绑定并保存新 key
cmd_bind() {
  local probe=0 yes=0 uid="" phoneid=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --probe) probe=1; shift ;;
      --yes) yes=1; shift ;;
      --userid) uid=$2; shift 2 ;;
      --phoneid) phoneid=$2; shift 2 ;;
      *) shift ;;
    esac
  done
  need_root; need_app
  [ -n "${MAC:-}" ] || MAC=$(detect_mac)
  [ -n "$MAC" ] || die "没找到手表 MAC（先用官方 App 配对，或写进 $CONF）"

  if [ $probe -eq 0 ] && [ $yes -ne 1 ]; then
    warn "这会和手表做一次本地 ECDH 绑定，给手表写入【全新的 auth key】"
    warn "之后官方 App（小米运动健康）将无法再连手表，除非重新配对"
    die "确认无误请加 --yes"
  fi

  local cmd=bind; [ $probe -eq 1 ] && cmd=bindprobe
  [ -n "$phoneid" ] || phoneid=$(read_phone_id 2>/dev/null)
  # 手表 SPP 通道会被官方 App 占用，先停掉
  su -c "am force-stop com.mi.health" 2>/dev/null
  sleep 1
  local js; js=$(okjson cmd="$cmd" userid="$uid" phoneid="$phoneid")
  local out=""
  if serve_up; then
    out=$(rpc_send "$js" 45) || true
  else
    local run="$$-$RANDOM" ex="--ez bind_now true"
    [ $probe -eq 1 ] && ex="--ez bind_probe true"
    su -c "am force-stop $PKG" 2>/dev/null
    sleep 1
    launch_app --es run_id "$run" $ex --es bind_userid "$uid" --es bind_phoneid "$phoneid"
    if ! wait_for "RUN $run" 25; then warn "App 没起来"; log_dump; return 1; fi
    sleep 22
    out=$(log_dump)
  fi
  printf '%s\n' "$out"

  if [ $probe -eq 1 ]; then
    if printf '%s' "$out" | grep -q "支持本地 ECDH 绑定"; then ok "手表允许本地绑定"; else warn "看上面的日志"; fi
    return 0
  fi

  local k
  k=$(printf '%s' "$out" | sed -nE 's/.*"key"[[:space:]]*:[[:space:]]*"([0-9a-fA-F]{32})".*/\1/p' | head -1)
  [ -z "$k" ] && k=$(printf '%s' "$out" | sed -nE 's/.*BINDKEY ([0-9a-fA-F]{32}).*/\1/p' | head -1)
  [ -n "$k" ] || die "没拿到新 key（看上面的日志）"
  KEY=$k; save_config
  ok "新 auth key = $KEY"
  info "已写入 $CONF —— 以后不再依赖官方 App 的密钥"
}

# ───────── 解绑（=恢复出厂 ERASE_ALL）/ 一键重绑 ─────────
#   miwear reset --yes     用现有 key 认证后发 module 2 sub 0（手表清数据/解绑）
#   miwear rebind --yes    reset + 等手表重启 + 本地 ECDH 重绑 → 新 key
cmd_reset() {
  local yes=0
  [ "${1:-}" = "--yes" ] && yes=1
  if [ $yes -ne 1 ]; then
    warn "reset = 解绑/恢复出厂（官方日志里叫 ERASE_ALL），手表上的数据会被清空！"
    die "确认无误请加 --yes"
  fi
  need_root; need_app; ensure_key
  su -c "am force-stop com.mi.health" 2>/dev/null
  sleep 1
  if serve_up; then
    rpc_send '{"cmd":"reset"}' 30 || warn "reset 无回执（设备本来就不回，正常）"
  else
    local run="$$-$RANDOM"
    su -c "am force-stop $PKG" 2>/dev/null; sleep 1
    launch_app --es run_id "$run" --ez unbind_reset true
    if ! wait_for "RUN $run" 25; then warn "App 没起来"; log_dump; return 1; fi
    sleep 6
    log_dump | tail -8
  fi
  ok "已发送解绑/恢复出厂（手表应会重启/回到未绑定状态）"
}

cmd_rebind() {
  local yes=0 uid="" phoneid=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --yes) yes=1; shift ;;
      --userid) uid=$2; shift 2 ;;
      --phoneid) phoneid=$2; shift 2 ;;
      *) shift ;;
    esac
  done
  if [ $yes -ne 1 ]; then
    warn "rebind = 先解绑（恢复出厂、清空手表）+ 再用本地 ECDH 生成全新 auth key"
    die "确认无误请加 --yes"
  fi
  cmd_reset --yes || return 1
  info "等手表重启并进入可绑定状态（最多 120s）…"
  local i out
  for i in $(seq 1 24); do
    sleep 5
    out=$(cmd_bind --probe 2>&1) || true
    if printf '%s' "$out" | grep -q "支持本地 ECDH 绑定"; then
      ok "手表已就绪，开始本地重绑…"
      cmd_bind --yes --userid "$uid" --phoneid "$phoneid" && return 0
      return 1
    fi
    printf '  %s\n' "$(printf '%s' "$out" | tail -1)"
  done
  die "手表一直没进入可绑定状态（可能要在手表上确认恢复出厂）"
}

# ───────── 常驻 CLI 服务 ─────────
# 静默启动（界面不出现）：fgs=带常驻通知（稳）/ bg=连通知都不要
svc_start() {
  local quiet=${1:-0} act="am start-foreground-service" extra=""
  if [ "$quiet" = 1 ]; then act="am start-service"; extra="--ez quiet true"; fi
  su -c "$act -n $(q "$PKG/.GatewayService") --ez serve true --ei port $(q "$PORT") --es mac $(q "$MAC") --es key $(q "$KEY") $extra" >/dev/null 2>&1
}

svc_stop() {
  su -c "am start-service -n $(q "$PKG/.GatewayService") --ez serve_stop true" >/dev/null 2>&1
}

cmd_serve() {
  local sub=${1:-start}
  case "$sub" in
    start|up|on)
      need_root; need_app; ensure_key
      local quiet=0
      [ "${2:-}" = "--quiet" ] && quiet=1
      if serve_up; then ok "服务已在运行（127.0.0.1:$PORT）"; return 0; fi
      # 白名单：避免被 Android 的 app freezer 冻结（联网时必须）
      su -c "dumpsys deviceidle whitelist +$PKG" >/dev/null 2>&1
      su -c "am set-standby-bucket $PKG active" >/dev/null 2>&1
      info "静默启动中（不会拉到前台）…"
      svc_start $quiet
      local i=0
      while [ $i -lt 24 ]; do sleep 0.5; serve_up && break; i=$((i+1)); done
      if serve_up; then
        ok "CLI 服务已启动：127.0.0.1:$PORT${D}（后台静默）${N}"
        [ $quiet = 1 ] && info "--quiet：无常驻通知（可能被系统回收，建议先加自启动/白名单）"
        info "认证常驻，后续 miwear 命令自动走它；已开启开机自启（小米需在应用信息里允许自启动）"
        return 0
      fi
      warn "静默启动失败，改用 Activity 模式（会短暂显示界面）…"
      su -c "am force-stop $PKG" >/dev/null 2>&1; sleep 1
      launch_app --es serve true --ei port "$PORT" --ez autoconnect false
      i=0
      while [ $i -lt 30 ]; do sleep 0.5; serve_up && break; i=$((i+1)); done
      serve_up || { warn "服务未起来，日志："; log_dump | tail -20; die "启动失败"; }
      ok "CLI 服务已启动：127.0.0.1:$PORT"
      ;;
    stop|down|off)
      need_root
      svc_stop; sleep 1
      if serve_up; then   # 服务没在跑时上面的 start-service 可能被拦，回退 Activity
        su -c "am start -n $ACT --ez serve_stop true" >/dev/null 2>&1; sleep 1
      fi
      if serve_up; then warn "还在跑？看一下 miwear log"; else ok "已停止（开机自启也已关闭）"; fi
      ;;
    status)
      if serve_up; then
        ok "运行中 127.0.0.1:$PORT"
        rpc_send '{"cmd":"state"}' 8 --raw
        su -c "ps -A -o NAME" 2>/dev/null | grep -q "$PKG" && info "进程存活；开机自启已开启"
      else
        warn "未运行（miwear serve start）"
      fi
      ;;
    autostart)
      need_root
      case "${2:-}" in
        on)  su -c "am broadcast -a com.termux.miwear.START -n $(q "$PKG/.BootReceiver") --ez serve true --es mac $(q "$MAC") --es key $(q "$KEY")" >/dev/null 2>&1; sleep 3; serve_up && ok "已启动且开机自启" || die "没起来" ;;
        off) su -c "am broadcast -a com.termux.miwear.STOP -n $(q "$PKG/.BootReceiver")" >/dev/null 2>&1; sleep 1; serve_up && warn "还在跑" || ok "已停止且关闭开机自启" ;;
        *)   die "用法: miwear serve autostart on|off" ;;
      esac
      ;;
    *) die "用法: miwear serve [start [--quiet]|stop|status|autostart on|off]" ;;
  esac
}

# ───────── log ─────────
cmd_log() {
  need_root
  local n=60 follow=0
  while [ $# -gt 0 ]; do
    case "$1" in
      -n) n=$2; shift 2 ;;
      -f) follow=1; shift ;;
      *) shift ;;
    esac
  done
  su -c "test -f $LOG" 2>/dev/null || die "还没有日志"
  if [ $follow -eq 1 ]; then
    if serve_up; then
      info "实时跟随服务日志（Ctrl-C 退出）…"
      rpc_send '{"cmd":"subscribe"}' 0 --follow
      return
    fi
    info "跟随日志（Ctrl-C 退出）…"
    su -c "tail -f $LOG" | sed -E 's/^(→|←) (DATA|CMD) seq=[0-9]+ ch=[0-9-]+ op=[0-9-]+ len=[0-9]+ .{60,}$/\1 \2 (帧数据略)/'
  else
    log_dump | tail -n "$n"
  fi
}

# ───────── build ─────────
token() { sed -nE 's#https://[^:]*:([^@]*)@github.com.*#\1#p' "$HOME/.git-credentials" 2>/dev/null | head -1; }
gh_api() { curl -s -m 30 -H "Authorization: token $(token)" -H "Accept: application/vnd.github+json" "$@"; }

cmd_build() {
  local kind=${1:-apk}; shift || true
  local do_install=0
  for a in "$@"; do [ "$a" = "--install" ] && do_install=1; done

  local wf artifact
  case "$kind" in
    apk) wf=build.yml;    artifact=miwear-ctl-apk ;;
    rpk) wf=quickapp.yml; artifact=quickapp-rpk ;;
    *) die "用法: miwear build apk|rpk [--install]" ;;
  esac
  local tk; tk=$(token); [ -n "$tk" ] || die "没找到 GitHub token（~/.git-credentials）"

  info "触发 $wf …"
  curl -s -m 30 -X POST -H "Authorization: token $tk" -H "Accept: application/vnd.github+json" \
    "https://api.github.com/repos/$REPO/actions/workflows/$wf/dispatches" \
    -d '{"ref":"main"}' -w "http=%{http_code}\n" -o /dev/null || die "dispatch 失败"

  info "等待构建…"
  local rid="" i s
  for i in $(seq 1 60); do
    sleep 10
    s=$(gh_api "https://api.github.com/repos/$REPO/actions/runs?per_page=5" | python3 -c "
import json,sys
d=json.load(sys.stdin)
for r in d.get('workflow_runs',[]):
    if r['path'].endswith('$wf'):
        print(r['id'], r['status'], r.get('conclusion') or '-'); break
")
    echo "  ${D}$s${N}"
    case "$s" in *completed\ success*) rid=$(echo "$s" | awk '{print $1}'); break ;;
                  *completed*) die "构建失败：https://github.com/$REPO/actions" ;;
    esac
  done
  [ -n "$rid" ] || die "构建超时"

  info "下载产物 $artifact …"
  mkdir -p "$HOME/miwear-ctl/dist"
  local aid="" i2
  for i2 in 1 2 3 4 5; do
    aid=$(gh_api "https://api.github.com/repos/$REPO/actions/runs/$rid/artifacts" \
          | python3 -c "import json,sys;a=json.load(sys.stdin)['artifacts'];print(a[0]['id'] if a else '')" 2>/dev/null)
    [ -n "$aid" ] && break
    sleep 6
  done
  [ -n "$aid" ] || die "拿不到 artifact id（构建产物可能已过期）"
  local got=0
  for i2 in 1 2 3 4 5; do
    rm -f "$TMP/art.zip"
    if curl -sL -m 300 --retry 3 --retry-delay 3 -H "Authorization: token $tk" \
         "https://api.github.com/repos/$REPO/actions/artifacts/$aid/zip" -o "$TMP/art.zip" \
       && unzip -tq "$TMP/art.zip" >/dev/null 2>&1; then got=1; break; fi
    info "下载重试 $i2 …"
    sleep 6
  done
  [ $got -eq 1 ] || die "下载产物失败（网络）"
  rm -rf "$TMP/art"; mkdir -p "$TMP/art"
  unzip -o -q "$TMP/art.zip" -d "$TMP/art" || die "解压失败"

  if [ "$kind" = rpk ]; then
    local f; f=$(find "$TMP/art" -name '*.rpk' | head -1)
    [ -n "$f" ] || die "产物里没有 rpk"
    cp "$f" "$HOME/miwear-ctl/dist/"; ok "rpk → ~/miwear-ctl/dist/$(basename "$f")"
    [ $do_install -eq 1 ] && cmd_install "$HOME/miwear-ctl/dist/$(basename "$f")"
  else
    local f; f=$(find "$TMP/art" -name '*.apk' | head -1)
    [ -n "$f" ] || die "产物里没有 apk"
    if [ $do_install -eq 1 ]; then
      need_root
      su -c "cp $(q "$f") /data/local/tmp/miwear.apk && chmod 644 /data/local/tmp/miwear.apk"
      su -c "pm install -r /data/local/tmp/miwear.apk" 2>&1 | tail -2
      su -c "pm grant $PKG android.permission.POST_NOTIFICATIONS" 2>/dev/null
      ok "APK 已安装"
    else
      ok "apk → $f"
    fi
  fi
}

# ───────── 入口 ─────────
case "${1:-}" in
  status)    shift; cmd_status "$@" ;;
  serve)     shift; cmd_serve "$@" ;;
  install)   shift; cmd_install "$@" ;;
  apps)      shift; cmd_apps "$@" ;;
  app)       shift; cmd_app "$@" ;;
  key)       shift; cmd_key "$@" ;;
  bind)      shift; cmd_bind "$@" ;;
  reset)     shift; cmd_reset "$@" ;;
  rebind)    shift; cmd_rebind "$@" ;;
  uninstall) shift; cmd_uninstall "$@" ;;
  launch)    shift; cmd_launch "$@" ;;
  notify)    shift; cmd_notify "$@" ;;
  call)      shift; cmd_call "$@" ;;
  info)      shift; cmd_info "$@" ;;
  battery)   shift; cmd_battery "$@" ;;
  probe)     shift; cmd_probe "$@" ;;
  fitness)   shift; cmd_fitness "$@" ;;
  sleep)     shift; cmd_sleep "$@" ;;
  alert)     shift; cmd_alert "$@" ;;
  find)      shift; cmd_find "$@" ;;
  msg)       shift; cmd_msg "$@" ;;
  sync)      shift; cmd_sync "$@" ;;
  raw)       shift; cmd_raw "$@" ;;
  rpc)       shift; cmd_rpc "$@" ;;
  net)       shift; cmd_net "$@" ;;
  log)       shift; cmd_log "$@" ;;
  build)     shift; cmd_build "$@" ;;
  ""|-h|--help|help) sed -n '2,34p' "$0" | sed 's/^# \{0,1\}//' ;;
  *) die "未知命令: $1（试 miwear help）" ;;
esac
