#!/data/data/com.termux/files/usr/bin/bash
# miwear —— REDMI Watch 5 直连工具（Termux + root）
#
# 一条命令完成：连接认证 / 装 rpk / 查应用 / 卸载 / 启动 / 推通知 / 看日志 / 云构建
#
# 用法:  miwear <命令> [参数]
#   status                    体检：root/蓝牙/锁屏/官方App/手表配对/本机 App
#   serve [start|stop|status] 启停常驻 CLI 服务（后台静默，认证只做一次，后续命令秒回）
#   serve start --quiet       同上，但不要常驻通知（可能被系统回收）
#   rpc '<json>'               直接向常驻服务发一条 JSON 命令（调试/脚本用）
#   install <a.rpk>           把 rpk 装到手表（自动停官方 App、自动等结果）
#   install --build           先云构建 quickapp 再装
#   apps                      列出手表上已安装的快应用
#   app <包名>                查询某个应用在手表上的状态
#   key [--save]              从官方 App 数据库读取 auth key（--save 写入配置）
#   key --set <hex>           手动指定 auth key 并写入配置
#   bind --probe              查手表是否允许本地绑定（不依赖官方 App）
#   bind --yes                本地 ECDH 绑定 → 生成全新 auth key 并保存（手表需未绑定）
#   reset --yes               解绑/恢复出厂（清空手表数据）
#   rebind --yes              一键：解绑 → 等重启 → 本地重绑生成新 key
#   uninstall <包名> [指纹]   卸载（设备不回执，看手表界面）
#   launch <包名> [uri]       在手表上启动应用（设备不回执）
#   notify <标题> <内容> [包]  推一条普通通知到手表（短震动）
#   call <号码> [姓名] [类型]   模拟来电（长震动/响铃）
#   info                      设备状态（电量 + 固件/型号/SN）
#   battery                   只读电量/充电状态（module 2 sub 1）
#   probe <module> <sub>      读任意官方信息接口，输出 protobuf 树
#                             （如 2/62 存储、8/10 心率、8/8 血氧、8/14 压力、8/12 久坐、17/8 睡眠模式）
#   fitness [ids|history|pushed]  列今日 data id / 历史 id / 手表已推送并落盘的记录
#   fitness fetch <id> [文件]   拉一条 data id 的原始数据（表 → 本机，ch5 传输；默认只读不确认）
#   sleep [--save <文件>] [--json] [--watch [--interval 秒]]  看睡眠：判断「现在是否在睡」（--watch 常驻盯变化）
#   sleep --daemon [--interval 秒]    开启睡眠监测（后台常驻，入睡/起床弹通知 + 记日志）
#   sleep --stop | --status | --log [-f] | --test-notify | --reset
#   alert <标题> <内容>               本机弹一条通知（App 自己发，有横幅+声音）
#   find                      找手表：让手表震动/响铃
#   msg <包名> <文本>          给手表快应用发消息（interconnect）
#   sync <包名> [状态]         同步手机 App 安装状态
#   raw <hex>                 发任意 oyt 明文（加密）并打印应答，调试用
#   net [--launch <包名> [uri]]  启动手表联网网关（手机侧 libnetproxy.so 做 NAT）
#   log [-n 行数] [-f]        看 App 日志（-f 持续跟随）
#   build apk|rpk [--install] 触发 GitHub Actions 构建
#
# 配置:  ~/.config/miwear/config      MAC=.. / KEY=.. / REPO=.. / PORT=..
#
# 两种模式（自动选）：
#   常驻模式  miwear serve start  → App 里跑个本地 socket 服务，认证只做一次，命令秒回、日志实时流
#   一次性模式  不开服务 → 每条命令 am start 拉起 App，做完即退（慢，但不用先起服务）
set -uo pipefail

PKG=com.miwear.ctl
ACT=$PKG/.MainActivity
FILES=/data/data/$PKG/files
LOG=$FILES/log.txt
TMP=${TMPDIR:-/tmp}/miwear
mkdir -p "$TMP" 2>/dev/null || TMP=$HOME/.miwear-tmp
mkdir -p "$TMP" 2>/dev/null || true

# ───────── 常驻服务（App 当蓝牙后端；见 CmdServer.java）─────────
SELF=$(readlink -f "${BASH_SOURCE[0]:-$0}" 2>/dev/null || echo "$0")
RPC_PY=${MIWEAR_RPC:-$(dirname "$SELF")/miwear_rpc.py}

# ───────── 配置 ─────────
CONF=${MIWEAR_CONF:-$HOME/.config/miwear/config}
[ -f "$CONF" ] && . "$CONF"
MAC=${MAC:-}
KEY=${KEY:-}
REPO=${REPO:-linuxwff789/miwear-ctl}
PORT=${PORT:-38787}

R=$'\033[31m'; G=$'\033[32m'; Y=$'\033[33m'; C=$'\033[36m'; D=$'\033[2m'; N=$'\033[0m'
die() { echo "${R}✗${N} $*" >&2; exit 1; }
ok()  { echo "${G}✓${N} $*"; }
info(){ echo "${C}·${N} $*"; }
warn(){ echo "${Y}!${N} $*"; }

# ───────── 基础 ─────────
need_root() { su -c true 2>/dev/null || die "需要 root（su）"; }
need_app()  { su -c "pm path $PKG" >/dev/null 2>&1 || die "$PKG 未安装，先跑: miwear build apk --install"; }

q() { printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"; }

# 打印 App 日志（长帧压缩显示）
log_dump() {
  su -c "cat $LOG 2>/dev/null" 2>/dev/null \
    | sed -E 's/^(→|←) (DATA|CMD) seq=[0-9]+ ch=[0-9-]+ op=[0-9-]+ len=[0-9]+ .{60,}$/\1 \2 (帧数据略)/'
}

# 等日志里出现某模式（扫描整个当前日志；调用前应先等本次的 RUN 标记）
wait_for() {
  local pat=$1 t=${2:-60} i=0
  while [ $i -lt $((t*2)) ]; do
    if log_dump | grep -qE "$pat"; then return 0; fi
    sleep 0.5; i=$((i+1))
  done
  return 1
}

launch_app() {
  local args=(-n "$ACT" --es mac "$MAC" --es key "$KEY" --ez autoconnect true --ez autoauth true)
  args+=("$@")
  local cmd="am start" a
  for a in "${args[@]}"; do cmd="$cmd $(q "$a")"; done
  su -c "$cmd" >/dev/null 2>&1 || die "am start 失败"
}

# ───────── 常驻服务 ─────────
# 直连 127.0.0.1:PORT；若 SELinux 不允许（少见），自动回退 root 跑 python
serve_up() { MIWEAR_PORT=$PORT python3 "$RPC_PY" --connect >/dev/null 2>&1; }

rpc_send() {  # rpc_send <json> <timeout秒> [额外参数…]
  local json=$1 t=$2; shift 2
  if serve_up; then
    MIWEAR_PORT=$PORT MIWEAR_CMD="$json" python3 "$RPC_PY" --from-env --port "$PORT" --timeout "$t" "$@"
    return $?
  fi
  need_root
  local py; py=$(command -v python3)
  su -c "MIWEAR_CMD=$(q "$json") $(q "$py") $(q "$RPC_PY") --from-env --port $PORT --timeout $t"
  return $?
}

# 把 am 风格 extra 转成 JSON 命令（空串 = 不认识）
extras_json() { python3 "$RPC_PY" --extras "$@" 2>/dev/null; }

okjson() {  # okjson <json键值对…> → 拼成 JSON
  python3 - "$@" <<'PY'
import json,sys
kv={}
for a in sys.argv[1:]:
    k,_,v=a.partition('='); kv[k]=v
print(json.dumps(kv,ensure_ascii=False))
PY
}

# 跑一次动作并等结果。失败自动重试一次（SPP 连接偶发失败）
do_action() {
  local pat=$1 t=$2; shift 2
  need_root; need_app
  # 常驻服务在跑 → 直接走本地 socket（认证已常驻，实时输出）
  if serve_up; then
    local js; js=$(extras_json "$@")
    if [ -n "$js" ]; then
      if rpc_send "$js" "$t"; then return 0; fi
      warn "RPC 失败，回退 Intent 模式"
    fi
  fi
  ensure_key
  local run="$$-$RANDOM" attempt
  for attempt in 1 2; do
    su -c "am force-stop com.mi.health; am force-stop $PKG" 2>/dev/null
    sleep 1
    launch_app --es run_id "$run" "$@"
    if ! wait_for "RUN $run" 25; then
      warn "App 没起来（am start 未生效）"; log_dump; return 1
    fi
    if wait_for "$pat" "$t"; then log_dump; return 0; fi
    if [ $attempt -eq 1 ]; then
      warn "第一次没成功，重试…"
      if [ "${MIWEAR_BTRESET:-0}" = 1 ]; then
        su -c "svc bluetooth disable" 2>/dev/null; sleep 3
        su -c "svc bluetooth enable" 2>/dev/null; sleep 8
      else sleep 2; fi
    fi
  done
  warn "失败，日志如下："; log_dump; return 1
}

# ───────── status ─────────
cmd_status() {
  need_root
  echo "── miwear 体检 ──"
  [ -n "${MAC:-}" ] || MAC=$(detect_mac)
  su -c "dumpsys bluetooth_manager" 2>/dev/null | grep -q "state: ON" && ok "蓝牙已开" || warn "蓝牙未开"
  local lock; lock=$(su -c "dumpsys window" 2>/dev/null | grep -oE 'mDreamingLockscreen=(true|false)' | head -1)
  case "$lock" in *false) ok "手机已解锁" ;; *true) warn "手机锁屏中（不影响，但建议解锁）" ;; esac
  su -c "dumpsys bluetooth_manager" 2>/dev/null | grep -q "$MAC" && ok "手表已配对 ($MAC)" || warn "未找到配对的手表 $MAC"
  su -c "pm path $PKG" >/dev/null 2>&1 && ok "miwear-ctl 已安装" || warn "miwear-ctl 未安装 → miwear build apk --install"
  if [ -n "${KEY:-}" ]; then ok "auth key 已配置"
  else info "auth key 未配置（首次推送时会自动从小米运动健康数据库读取）"; fi
  su -c "ps -A" 2>/dev/null | grep -q com.mi.health \
    && warn "小米运动健康正在运行（推送时会自动停掉）" || ok "官方 App 未运行（SPP 通道空闲）"
  if serve_up; then ok "常驻 CLI 服务在跑（127.0.0.1:$PORT，命令秒回）"
  else info "常驻服务未开（miwear serve start 可加速 + 实时日志）"; fi
  info "配置：MAC=$MAC  KEY=${KEY:0:8}…  REPO=$REPO"
}

# ───────── install ─────────
cmd_install() {
  local rpk=""
  if [ "${1:-}" = "--build" ]; then
    shift; cmd_build rpk "$@"
    rpk=$(ls -t "$HOME/miwear-ctl/dist/"*.rpk 2>/dev/null | head -1)
    [ -n "$rpk" ] || die "构建后没找到 rpk"
  else
    rpk=${1:-}; [ -n "$rpk" ] || die "用法: miwear install <a.rpk>"
  fi
  local sz; sz=$(su -c "stat -c %s $(q "$rpk") 2>/dev/null")
  [ -n "$sz" ] || die "文件不存在或读不到: $rpk"

  need_root; need_app
  ensure_key
  local base; base=$(basename "$rpk"); local dst=$FILES/$base
  if [ "$rpk" != "$dst" ]; then
    su -c "cp $(q "$rpk") $dst && chmod 644 $dst" || die "拷贝 rpk 失败"
  else
    su -c "chmod 644 $dst"
  fi
  info "安装 $base（$sz 字节）"

  # 常驻服务在跑 → 直接 socket 安装（不用重启 App、不用 am start）
  if serve_up; then
    if rpc_send "$(okjson cmd=install path="$dst")" 300; then
      echo
      ok "已发送完成。${D}设备对安装只回 L1 ACK，看下手表即可${N}"
      return 0
    fi
    warn "RPC 安装失败，回退 Intent 模式"
  fi

  local run="$$-$RANDOM"
  su -c "am force-stop com.mi.health; am force-stop $PKG" 2>/dev/null
  sleep 1
  launch_app --es run_id "$run" --es install_rpk "$dst"  wait_for "RUN $run" 25 || { warn "App 没起来"; log_dump; return 1; }
  if wait_for "rpk 发送完成|❌" 90; then
    log_dump
    echo
    ok "已发送完成。${D}设备对安装只回 L1 ACK，没有「安装成功」回执属正常——看一眼手表即可${N}"
  else
    warn "超时，日志如下："; log_dump
  fi
}

# ───────── 应用管理 ─────────
cmd_apps() { do_action "共 [0-9]+ 个应用|设备无应答" 40 --ez list_apps true; }

cmd_app() {
  local pkg=${1:-}; [ -n "$pkg" ] || die "用法: miwear app <包名>"
  do_action "应用状态应答" 40 --es app_pkg "$pkg"
}

cmd_uninstall() {
  local pkg=${1:-}; [ -n "$pkg" ] || die "用法: miwear uninstall <包名> [指纹hex]"
  local fp=${2:-}
  [ -n "$fp" ] || info "未给指纹（设备一般不校验；若失败先用 miwear apps 取指纹）"
  do_action "卸载应答" 40 --es uninstall_pkg "$pkg" --es uninstall_fp "$fp" >/dev/null
  ok "卸载指令已发送。${D}设备对卸载不回执，看手表应用列表是否已移除${N}"
}

cmd_launch() {
  local pkg=${1:-}; [ -n "$pkg" ] || die "用法: miwear launch <包名> [uri]"
  local uri=${2:-}
  if [ -n "$uri" ]; then
    do_action "启动应答" 40 --es launch_pkg "$pkg" --es launch_uri "$uri" >/dev/null
  else
    do_action "启动应答" 40 --es launch_pkg "$pkg" >/dev/null
  fi
  ok "启动指令已发送。${D}设备对启动不回执，看手表屏幕${N}"
}

cmd_notify() {
  local t=${1:-}; local x=${2:-}; local p=${3:-com.termux}
  [ -n "$t" ] || die "用法: miwear notify <标题> <内容> [包名]"
  do_action "通知 oyt" 40 --es notify_title "$t" --es notify_text "$x" --es notify_pkg "$p"
}

# 来电通知（包名 "phone" + f8=callType）
cmd_call() {
  local num=${1:-}; local name=${2:-}; local ct=${3:-1}
  [ -n "$num" ] || die "用法: miwear call <号码> [姓名] [类型1=来电/2=去电/3=未接]"
  do_action "来电 callType" 40 --es call_number "$num" --es call_name "$name" --ei call_type "$ct"
}

# 设备状态（module 8 sub 29，含电量）
cmd_info() { do_action "电量|固件版本" 40 --ez query_status true; }

# 电量/充电（官方 module 2 sub 1）
cmd_battery() { do_action "电量" 40 --ez battery_only true; }

# 读任意 module/sub（官方读接口），输出 protobuf 树
cmd_probe() {
  local m=${1:-} s=${2:-}
  [ -n "$m" ] && [ -n "$s" ] || die "用法: miwear probe <module> <sub>"
  need_root; need_app; ensure_key
  if serve_up; then rpc_send "$(okjson cmd=probe mod="$m" sub="$s")" 30 && return 0; fi
  do_action "module $m sub $s" 40 --ei probe_mod "$m" --ei probe_sub "$s"
}

# ───────── 健身 / 睡眠数据（直接从手表读，module 8 + ch5）─────────
# 拉一条 data id 的原始数据落盘；回显最终文件路径
fit_fetch_to() {  # fit_fetch_to <idhex> <outfile> [confirm]
  local id=$1 out=$2 confirm=${3:-false} json path
  json=$(rpc_send "$(okjson cmd=fitfetch id="$id" confirm="$confirm")" 180 --raw 2>/dev/null | grep '"ev":"done"' | tail -1)
  path=$(printf '%s' "$json" | python3 -c '
import sys,json
try: d=json.loads(sys.stdin.read() or "{}")
except Exception: d={}
v=d.get("data")
print(v.get("path","") if isinstance(v,dict) else "")
' 2>/dev/null)
  [ -n "$path" ] || return 1
  su -c "cat '$path'" > "$out" 2>/dev/null || return 1
  return 0
}

fit_ids_json() {  # fit_ids_json <1|2> → JSON 数组
  local s=${1:-1}
  rpc_send "$(okjson cmd=fitids sub=$s)" 60 --raw 2>/dev/null \
    | grep '"ev":"done"' | tail -1 \
    | python3 -c '
import sys,json
try: d=json.loads(sys.stdin.read() or "{}")
except Exception: d={}
print(json.dumps(d.get("data") or [], ensure_ascii=False))
' 2>/dev/null
}

# 从 ids JSON 里选出「最相关的睡眠段」：dt8/ft1 > dt3 > dt2 > 最新 DailyRecord
fit_pick() {  # stdin: ids JSON → "<id> <type> <time>"
  python3 -c '
import sys,json
ids=json.load(sys.stdin)
def score(i):
    if i["dailyType"]==8 and i["fileType"]==1: return 3
    if i["dailyType"] in (2,3): return 2
    if i["dailyType"]==0 and i["fileType"]==0: return 1
    return 0
best=[i for i in ids if score(i)>0]
if not best: sys.exit(0)
best.sort(key=lambda i:(score(i), i["ts"]), reverse=True)
print(best[0]["id"], best[0]["type"], best[0]["time"])
'
}
# 只看睡眠段（不含 DailyRecord）
fit_pick_sleep() {
  python3 -c '
import sys,json
ids=json.load(sys.stdin)
sl=[i for i in ids if i.get("sleep")]
if not sl: sys.exit(0)
sl.sort(key=lambda i:i["ts"], reverse=True)
print(sl[0]["id"], sl[0]["type"], sl[0]["time"])
'
}

fit_pushed() {  # 手表推送并落盘的记录：<ts> <id> <type> <ver> <dailyType> <fileType>，按时间倒序
  su -c "ls -1 /data/data/$PKG/files/fitness/*.bin 2>/dev/null" 2>/dev/null \
    | sed 's#.*/##; s#\.bin$##' | python3 -c '
import sys
DAILY={0:{0:"DailyRecord",1:"DailyReport"},2:"DaytimeSleep",3:"NightSleep",5:"UserProfile",6:"ManualMeasure",8:"AllDaySleep",9:"Abnormal",10:"Weight",11:"ECG",12:"Temperature"}
rows=[]
for line in sys.stdin:
    h=line.strip()
    try: b=bytes.fromhex(h)
    except Exception: continue
    if len(b)<7: continue
    ts=int.from_bytes(b[:4],"little"); ver,t=b[5],b[6]
    dt=(t>>7)&1; daily=0 if dt else (t&0x7f)>>2; ft=t&3
    n=DAILY.get(daily)
    name=n.get(ft,"daily%d/file%d"%(daily,ft)) if isinstance(n,dict) else (n or "daily%d/file%d"%(daily,ft))
    rows.append((ts,h,name,ver,daily,ft))
rows.sort(reverse=True)
for ts,h,name,ver,daily,ft in rows:
    print(ts,h,name,ver,daily,ft)
'
}

# 从推送文件里选最新的一条睡眠段（dt8/ft1 优先，其次 dt3/dt2）
fit_pushed_sleep() {
  fit_pushed | python3 -c '
import sys
best=None
for line in sys.stdin:
    f=line.split()
    if len(f)<6: continue
    ts,h,name,ver,daily,ft=int(f[0]),f[1],f[2],f[3],int(f[4]),int(f[5])
    sc=3 if (daily==8 and ft==1) else (2 if daily in (2,3) else 0)
    if sc and (best is None or (sc,ts)>(best[0],best[1])): best=(sc,ts,h,name)
if best: print(best[2],best[3])
'
}

fit_conclusion() {  # fit_conclusion <bin文件>
  python3 "$(dirname "$0")/fitness_decode.py" "$1" --json 2>/dev/null | python3 -c '
import sys,json,time
try: d=json.load(sys.stdin)
except Exception: sys.exit(0)
def f(x): return time.strftime("%m-%d %H:%M", time.localtime(x)) if x else "-"
s=d.get("sleep")
if not s: sys.exit(0)
if s.get("isSleepFinish"):
    print("结论 : 现在清醒（这段睡眠：%s → %s，共 %.1f 小时）"
          % (f(s["bedTime"]), f(s["wakeupTime"]), (s["wakeupTime"]-s["bedTime"])/3600))
else:
    print("结论 : 😴 正在睡觉！（尚未结束，入睡 %s，已 %.1f 小时）"
          % (f(s["bedTime"]), (time.time()-s["bedTime"])/3600))
'
}

cmd_fitness() {
  local sub=${1:-ids}; shift || true
  case "$sub" in
    ids|history)
      local s=1; [ "$sub" = history ] && s=2
      serve_up || die "需要常驻服务：miwear serve start"
      rpc_send "$(okjson cmd=fitids sub=$s)" 60 | grep -v '^\[{'
      ;;
    pushed)
      fit_pushed | while read -r ts h name ver daily ft; do
        printf '  • %s  %-24s ver=%s {daily=%s, file=%s}  id=%s\n' \
          "$(date -d @$ts '+%m-%d %H:%M:%S' 2>/dev/null || echo "@$ts")" "$name" "$ver" "$daily" "$ft" "$h"
      done
      ;;
    fetch)
      local id=${1:-}; shift || true
      [ -n "$id" ] || die "用法: miwear fitness fetch <14位hex id> [输出文件] [--confirm]"
      [ ${#id} -eq 14 ] || die "data id 必须是 14 位 hex（7 字节）"
      serve_up || die "需要常驻服务：miwear serve start"
      local confirm=false out=""
      for a in "$@"; do
        case "$a" in --confirm) confirm=true ;; *) [ -z "$out" ] && out=$a ;; esac
      done
      [ -n "$out" ] || out=$HOME/miwear-fitness-$(date +%Y%m%d-%H%M%S)-$id.bin
      if fit_fetch_to "$id" "$out" "$confirm"; then
        ok "已保存 $out（$(wc -c < "$out") 字节）$( [ "$confirm" = true ] && echo '，已回 8/5 确认' || echo '（只读，未确认）') "
        python3 "$(dirname "$0")/fitness_decode.py" "$out" 2>/dev/null | head -24 || true
        echo "$out"
      else
        die "拉取失败（miwear log -n 40 看细节）"
      fi
      ;;
    *) die "用法: miwear fitness [ids|history|pushed|fetch <id>]" ;;
  esac
}

# 本机通知（由 App 发，免 termux-api 依赖）
cmd_alert() {
  local title=${1:-miwear}; local text=${2:-}
  [ -n "$text" ] || text="（无内容）"
  serve_up || die "需要常驻服务：miwear serve start"
  rpc_send "$(okjson cmd=alert title="$title" text="$text")" 20 >/dev/null || die "发送失败"
  ok "已发本机通知：$title"
}

SLEEPD_DIR=${MIWEAR_SLEEP_DIR:-$HOME/.miwear-sleep}
SLEEPD_PID=$SLEEPD_DIR/sleepd.pid
SLEEPD_LOG=$SLEEPD_DIR/sleepd.log

# 睡眠监测现在跑在 App 里（不依赖 Termux）；下面这几个只转发到 CmdServer 的 sleepmon 命令
sleepmon_rpc() { rpc_send "$(okjson cmd=sleepmon action="$1" ${2:+interval="$2"})" 30 --raw 2>/dev/null | grep '"ev":"done"' | tail -1; }

sleepd_alive() {  # 统一叫法：App 里的监测在跑
  local j; j=$(sleepmon_rpc status)
  printf '%s' "$j" | grep -q '"running":true'
}

sleepd_start() {  # sleepd_start <interval秒>
  local interval=${1:-60}
  serve_up || die "需要常驻服务：miwear serve start（App 的后台服务负责连接手表）"
  local j; j=$(sleepmon_rpc start "$interval")
  sleep 1
  if sleepd_alive; then
    ok "睡眠监测已在 App 内开启（每 ${interval}s 一次）"
    info "入睡/起床时 App 会弹本机通知；日志：miwear sleep --log"
    info "可在 App 界面的「开启监测」按钮同开关；已开启则开机自启"
  else
    warn "已下发开启命令，但没看到运行标志（miwear log -n 30 看看）"
  fi
}

sleepd_stop() {
  serve_up || true
  sleepmon_rpc stop >/dev/null 2>&1
  ok "已关闭睡眠监测（App 内）"
}

sleepd_status() {
  serve_up || { warn "常驻服务未运行：miwear serve start"; return 1; }
  local j; j=$(sleepmon_rpc status)
  python3 -c '
import sys,json,time
raw=sys.stdin.read().strip()
try: d=json.loads(raw).get("data") or {}
except Exception: d={}
if isinstance(d,str):
    try: d=json.loads(d)
    except Exception: d={}
print("  运行中: " + ("✓" if d.get("running") else "✗（miwear sleep --daemon 开启）"))
print("  当前状态: " + ("😴 睡眠中" if d.get("state")=="asleep" else "清醒"))
print("  轮询间隔: %ss" % d.get("interval", "?"))
for k,label in (("bedTime","入睡时间"),("wakeupTime","起床时间"),("detectedAt","最近检测时间")):
    v=d.get(k) or 0
    if v: print("  %s: %s" % (label, time.strftime("%m-%d %H:%M:%S", time.localtime(v))))
if d.get("lastId"): print("  最近记录: " + d["lastId"])
' <<< "$j"
  # 兼容旧版 Termux 守护（若还在跑）
  if [ -f "$SLEEPD_PID" ] && kill -0 "$(cat "$SLEEPD_PID")" 2>/dev/null; then
    warn "（另：旧版 Termux 守护还在跑 pid $(cat "$SLEEPD_PID")，建议 miwear sleep --stop-legacy）"
  fi
  echo "  最近事件:"
  sleep_log_tail 4 | sed 's/^/    /'
  return 0
}

sleep_log_tail() {  # sleep_log_tail <N>：优先 App 内日志，其次旧文件
  local n=${1:-30} out
  out=$(rpc_send '{"cmd":"sleeplog"}' 30 --raw 2>/dev/null | grep '"ev":"done"' | tail -1 \
        | python3 -c 'import sys,json
try: d=json.loads(sys.stdin.read() or "{}")
except Exception: d={}
print(d.get("data") or "")' 2>/dev/null)
  if [ -n "$out" ]; then printf '%s\n' "$out" | head -"$n"; return; fi
  [ -f "$SLEEPD_DIR/sleep.log" ] && tail -n "$n" "$SLEEPD_DIR/sleep.log"
}

# 看睡眠：拉今日最新睡眠段（AllDaySleep）+ 最新打点，判断「现在是否在睡」
#   miwear sleep [--save <文件>] [--json] [--watch] [--interval 秒]
#   miwear sleep --daemon [--interval 秒] | --stop | --status | --log [-f] | --test-notify
cmd_sleep() {
  local save="" asjson=0 watch=0 interval=60
  local daemon=0 stop=0 status=0 dolog=0 testnotify=0 tailn=30 follow=0 reset=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --save) save=${2:-}; shift 2 ;;
      --json) asjson=1; shift ;;
      --watch) watch=1; shift ;;
      --daemon|--on) daemon=1; shift ;;
      --stop|--off) stop=1; shift ;;
      --status) status=1; shift ;;
      --log) dolog=1; shift ;;
      --test-notify) testnotify=1; shift ;;
      --reset) reset=1; shift ;;
      -f|--follow) follow=1; shift ;;
      -n) tailn=${2:-30}; shift 2 ;;
      --interval) interval=${2:-60}; shift 2 ;;
      *) shift ;;
    esac
  done
  if [ $testnotify -eq 1 ]; then
    serve_up || die "需要常驻服务：miwear serve start"
    rpc_send '{"cmd":"sleepmon","action":"test"}' 20 >/dev/null || die "发送失败"
    ok "已发测试通知"
    return 0
  fi
  if [ $stop -eq 1 ]; then sleepd_stop; return 0; fi
  if [ $reset -eq 1 ]; then
    serve_up || die "需要常驻服务：miwear serve start"
    rpc_send '{"cmd":"sleepmon","action":"reset"}' 20 >/dev/null || die "重置失败"
    ok "已清空睡眠监测状态/日志（状态机回到清醒）"
    return 0
  fi
  if [ $status -eq 1 ]; then sleepd_status; return 0; fi
  if [ $dolog -eq 1 ]; then
    if [ $follow -eq 1 ]; then
      while true; do sleep_log_tail "$tailn"; sleep 5; done
    else
      sleep_log_tail "$tailn"
    fi
    return 0
  fi
  if [ $daemon -eq 1 ]; then sleepd_start "$interval"; return 0; fi
  serve_up || die "需要常驻服务：miwear serve start"

  if [ "$watch" = 1 ]; then
    local last="" lastconcl="暂无"
    info "盯睡眠中（每 ${interval}s 一次，Ctrl-C 退出；表主动推送的记录会落盘）…"
    while true; do
      local pick
      pick=$(fit_pushed_sleep)
      if [ -n "$pick" ]; then
        set -- $pick
        local id=$1 kind=$2
        if [ "$id" != "$last" ]; then
          last=$id
          local tmp=$HOME/.miwear-sleep-watch.bin
          if su -c "cat /data/data/$PKG/files/fitness/$id.bin" > "$tmp" 2>/dev/null; then
            echo "[$(date '+%m-%d %H:%M:%S')] 🆕 睡眠记录 $id  $kind"
            python3 "$(dirname "$0")/fitness_decode.py" "$tmp" | sed -n '5,11p'
            lastconcl=$(fit_conclusion "$tmp")
            echo "$lastconcl"
          fi
        else
          echo "[$(date '+%m-%d %H:%M:%S')] 无变化  $lastconcl"
        fi
      else
        echo "[$(date '+%m-%d %H:%M:%S')] 暂无可用的睡眠段（等手表推送 / 或单跑一次 miwear sleep）"
      fi
      sleep "$interval"
    done
  fi

  # 一次性：优先用手表已推送的记录，没有才去拉 ids
  local pushed
  pushed=$(fit_pushed_sleep)
  if [ -n "$pushed" ]; then
    set -- $pushed
    local pid=$1 pkind=$2
    info "用手表已推送的睡眠记录：$pkind"
    local pout=${save:-$HOME/miwear-sleep-$(date +%Y%m%d-%H%M%S)-$pid.bin}
    su -c "cat /data/data/$PKG/files/fitness/$pid.bin" > "$pout" 2>/dev/null || die "读推送文件失败"
    ok "已保存 $pout（$(wc -c < "$pout") 字节）"
    if [ $asjson -eq 1 ]; then
      python3 "$(dirname "$0")/fitness_decode.py" "$pout" --json
    else
      python3 "$(dirname "$0")/fitness_decode.py" "$pout"
    fi
    fit_conclusion "$pout"
    return 0
  fi

  local json
  json=$(fit_ids_json 1)
  [ -n "$json" ] && [ "$json" != "[]" ] || die "没读到健身 data id"

  local pick
  pick=$(printf '%s' "$json" | fit_pick)
  [ -n "$pick" ] || die "今天还没读到的睡眠记录"
  set -- $pick
  local id=$1 kind="$2 $3"
  info "最新睡眠相关记录：$kind"

  local out=${save:-$HOME/miwear-sleep-$(date +%Y%m%d-%H%M%S)-$id.bin}
  fit_fetch_to "$id" "$out" false || die "拉取失败（miwear log -n 40 看细节）"
  ok "已保存 $out（$(wc -c < "$out") 字节，只读未确认）"
  if [ $asjson -eq 1 ]; then
    python3 "$(dirname "$0")/fitness_decode.py" "$out" --json
  else
    python3 "$(dirname "$0")/fitness_decode.py" "$out"
  fi
  fit_conclusion "$out"
}

