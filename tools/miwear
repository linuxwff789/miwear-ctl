#!/data/data/com.termux/files/usr/bin/bash
# miwear —— REDMI Watch 5 直连工具（Termux + root）
#
# 一条命令完成：连接认证 / 装 rpk / 查应用 / 卸载 / 启动 / 推通知 / 看日志 / 云构建
#
# 用法:  miwear <命令> [参数]
#   status                    体检：root/蓝牙/锁屏/官方App/手表配对/本机 App
#   install <a.rpk>           把 rpk 装到手表（自动停官方 App、自动等结果）
#   install --build           先云构建 quickapp 再装
#   apps                      列出手表上已安装的快应用
#   app <包名>                查询某个应用在手表上的状态
#   key [--save]              从官方 App 数据库自动读取 auth key（--save 写入配置）
#   uninstall <包名> [指纹]   卸载（设备不回执，看手表界面）
#   launch <包名> [uri]       在手表上启动应用（设备不回执）
#   notify <标题> <内容> [包]  推一条通知到手表
#   info                      查询设备状态（电量等，module 2 sub 78）
#   find                      找手表：让手表震动/响铃
#   msg <包名> <文本>          给手表快应用发消息（interconnect）
#   sync <包名> [状态]         同步手机 App 安装状态
#   raw <hex>                 发任意 oyt 明文（加密）并打印应答，调试用
#   net [--launch <包名> [uri]]  启动手表联网网关（手机侧 libnetproxy.so 做 NAT）
#   log [-n 行数] [-f]        看 App 日志（-f 持续跟随）
#   build apk|rpk [--install] 触发 GitHub Actions 构建
#
# 配置:  ~/.config/miwear/config      MAC=.. / KEY=.. / REPO=..
set -uo pipefail

PKG=com.miwear.ctl
ACT=$PKG/.MainActivity
FILES=/data/data/$PKG/files
LOG=$FILES/log.txt
TMP=${TMPDIR:-/tmp}/miwear
mkdir -p "$TMP" 2>/dev/null || TMP=$HOME/.miwear-tmp
mkdir -p "$TMP" 2>/dev/null || true

# ───────── 配置 ─────────
CONF=${MIWEAR_CONF:-$HOME/.config/miwear/config}
[ -f "$CONF" ] && . "$CONF"
MAC=${MAC:-}
KEY=${KEY:-}
REPO=${REPO:-linuxwff789/miwear-ctl}

R=$'\033[31m'; G=$'\033[32m'; Y=$'\033[33m'; C=$'\033[36m'; D=$'\033[2m'; N=$'\033[0m'
die() { echo "${R}✗${N} $*" >&2; exit 1; }
ok()  { echo "${G}✓${N} $*"; }
info(){ echo "${C}·${N} $*"; }
warn(){ echo "${Y}!${N} $*"; }

# ───────── 基础 ─────────
need_root() { su -c true 2>/dev/null || die "需要 root（su）"; }
need_app()  { su -c "pm path $PKG" >/dev/null 2>&1 || die "$PKG 未安装，先跑: miwear build apk --install"; }

q() { printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"; }

# 打印 App 日志（长帧压缩显示）
log_dump() {
  su -c "cat $LOG 2>/dev/null" 2>/dev/null \
    | sed -E 's/^(→|←) (DATA|CMD) seq=[0-9]+ ch=[0-9-]+ op=[0-9-]+ len=[0-9]+ .{60,}$/\1 \2 (帧数据略)/'
}

# 等日志里出现某模式（扫描整个当前日志；调用前应先等本次的 RUN 标记）
wait_for() {
  local pat=$1 t=${2:-60} i=0
  while [ $i -lt $((t*2)) ]; do
    if log_dump | grep -qE "$pat"; then return 0; fi
    sleep 0.5; i=$((i+1))
  done
  return 1
}

launch_app() {
  local args=(-n "$ACT" --es mac "$MAC" --es key "$KEY" --ez autoconnect true --ez autoauth true)
  args+=("$@")
  local cmd="am start" a
  for a in "${args[@]}"; do cmd="$cmd $(q "$a")"; done
  su -c "$cmd" >/dev/null 2>&1 || die "am start 失败"
}

# 跑一次动作并等结果。失败自动重试一次（SPP 连接偶发失败）
do_action() {
  local pat=$1 t=$2; shift 2
  ensure_key; need_root; need_app
  local run="$$-$RANDOM" attempt
  for attempt in 1 2; do
    su -c "am force-stop com.mi.health; am force-stop $PKG" 2>/dev/null
    sleep 1
    launch_app --es run_id "$run" "$@"
    if ! wait_for "RUN $run" 25; then
      warn "App 没起来（am start 未生效）"; log_dump; return 1
    fi
    if wait_for "$pat" "$t"; then log_dump; return 0; fi
    if [ $attempt -eq 1 ]; then
      warn "第一次没成功，重试…"
      if [ "${MIWEAR_BTRESET:-0}" = 1 ]; then
        su -c "svc bluetooth disable" 2>/dev/null; sleep 3
        su -c "svc bluetooth enable" 2>/dev/null; sleep 8
      else sleep 2; fi
    fi
  done
  warn "失败，日志如下："; log_dump; return 1
}

# ───────── status ─────────
cmd_status() {
  need_root
  echo "── miwear 体检 ──"
  [ -n "${MAC:-}" ] || MAC=$(detect_mac)
  su -c "dumpsys bluetooth_manager" 2>/dev/null | grep -q "state: ON" && ok "蓝牙已开" || warn "蓝牙未开"
  local lock; lock=$(su -c "dumpsys window" 2>/dev/null | grep -oE 'mDreamingLockscreen=(true|false)' | head -1)
  case "$lock" in *false) ok "手机已解锁" ;; *true) warn "手机锁屏中（不影响，但建议解锁）" ;; esac
  su -c "dumpsys bluetooth_manager" 2>/dev/null | grep -q "$MAC" && ok "手表已配对 ($MAC)" || warn "未找到配对的手表 $MAC"
  su -c "pm path $PKG" >/dev/null 2>&1 && ok "miwear-ctl 已安装" || warn "miwear-ctl 未安装 → miwear build apk --install"
  if [ -n "${KEY:-}" ]; then ok "auth key 已配置"
  else info "auth key 未配置（首次推送时会自动从小米运动健康数据库读取）"; fi
  su -c "ps -A" 2>/dev/null | grep -q com.mi.health \
    && warn "小米运动健康正在运行（推送时会自动停掉）" || ok "官方 App 未运行（SPP 通道空闲）"
  info "配置：MAC=$MAC  KEY=${KEY:0:8}…  REPO=$REPO"
}

# ───────── install ─────────
cmd_install() {
  local rpk=""
  if [ "${1:-}" = "--build" ]; then
    shift; cmd_build rpk "$@"
    rpk=$(ls -t "$HOME/miwear-ctl/dist/"*.rpk 2>/dev/null | head -1)
    [ -n "$rpk" ] || die "构建后没找到 rpk"
  else
    rpk=${1:-}; [ -n "$rpk" ] || die "用法: miwear install <a.rpk>"
  fi
  local sz; sz=$(su -c "stat -c %s $(q "$rpk") 2>/dev/null")
  [ -n "$sz" ] || die "文件不存在或读不到: $rpk"

  need_root; need_app
  ensure_key
  local base; base=$(basename "$rpk"); local dst=$FILES/$base
  if [ "$rpk" != "$dst" ]; then
    su -c "cp $(q "$rpk") $dst && chmod 644 $dst" || die "拷贝 rpk 失败"
  else
    su -c "chmod 644 $dst"
  fi
  info "安装 $base（$sz 字节）"

  local run="$$-$RANDOM"
  su -c "am force-stop com.mi.health; am force-stop $PKG" 2>/dev/null
  sleep 1
  launch_app --es run_id "$run" --es install_rpk "$dst"
  wait_for "RUN $run" 25 || { warn "App 没起来"; log_dump; return 1; }
  if wait_for "rpk 发送完成|❌" 90; then
    log_dump
    echo
    ok "已发送完成。${D}设备对安装只回 L1 ACK，没有「安装成功」回执属正常——看一眼手表即可${N}"
  else
    warn "超时，日志如下："; log_dump
  fi
}

# ───────── 应用管理 ─────────
cmd_apps() { do_action "共 [0-9]+ 个应用|设备无应答" 40 --ez list_apps true; }

cmd_app() {
  local pkg=${1:-}; [ -n "$pkg" ] || die "用法: miwear app <包名>"
  do_action "应用状态应答" 40 --es app_pkg "$pkg"
}

cmd_uninstall() {
  local pkg=${1:-}; [ -n "$pkg" ] || die "用法: miwear uninstall <包名> [指纹hex]"
  local fp=${2:-}
  [ -n "$fp" ] || info "未给指纹（设备一般不校验；若失败先用 miwear apps 取指纹）"
  do_action "卸载应答" 40 --es uninstall_pkg "$pkg" --es uninstall_fp "$fp" >/dev/null
  ok "卸载指令已发送。${D}设备对卸载不回执，看手表应用列表是否已移除${N}"
}

cmd_launch() {
  local pkg=${1:-}; [ -n "$pkg" ] || die "用法: miwear launch <包名> [uri]"
  local uri=${2:-}
  if [ -n "$uri" ]; then
    do_action "启动应答" 40 --es launch_pkg "$pkg" --es launch_uri "$uri" >/dev/null
  else
    do_action "启动应答" 40 --es launch_pkg "$pkg" >/dev/null
  fi
  ok "启动指令已发送。${D}设备对启动不回执，看手表屏幕${N}"
}

cmd_notify() {
  local t=${1:-}; local x=${2:-}; local p=${3:-com.termux}
  [ -n "$t" ] || die "用法: miwear notify <标题> <内容> [包名]"
  do_action "通知 oyt" 40 --es notify_title "$t" --es notify_text "$x" --es notify_pkg "$p"
}

# 设备状态（module 2 sub 78）
cmd_info() { do_action "设备状态" 40 --ez query_status true; }

# 找手表：让手表震动/响铃（module 2 sub 18）
cmd_find() {
  do_action "找手表" 40 --ez find_device true >/dev/null
  ok "已发送「找手表」指令。${D}手表应会震动/响铃${N}"
}

# 给手表快应用发消息（module 20 sub 8；快应用侧 @system.interconnect.onmessage）
cmd_msg() {
  local pkg=${1:-}; local text=${2:-}
  [ -n "$pkg" ] && [ -n "$text" ] || die "用法: miwear msg <包名> <文本>"
  do_action "发消息应答" 40 --es msg_pkg "$pkg" --es msg_text "$text"
}

# 同步手机 App 安装状态（module 20 sub 7）
cmd_sync() {
  local pkg=${1:-}; local st=${2:-1}
  [ -n "$pkg" ] || die "用法: miwear sync <包名> [状态1=已装/2=未装/3=手机没装]"
  do_action "同步应用状态应答" 40 --es sync_pkg "$pkg" --ei sync_status "$st"
}

cmd_raw() {
  local h=${1:-}; [ -n "$h" ] || die "用法: miwear raw <oyt的hex>"
  do_action "应答明文" 40 --es raw_hex "$h"
}

# 启动手表联网网关（手机侧跑 libnetproxy.so，把 ch7 的 IP 包做 NAT）
#   miwear net [--launch <包名> [uri]]   可选：同时拉起手表上的应用
cmd_net() {
  local lp="" lu=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --launch) lp=${2:-}; shift 2 ;;
      *) [ -n "$lp" ] && [ -z "$lu" ] && lu=$1; shift ;;
    esac
  done
  ensure_key; need_root; need_app
  su -c "dumpsys deviceidle whitelist +$PKG" >/dev/null 2>&1
  su -c "am set-standby-bucket $PKG active" >/dev/null 2>&1
  local run="$$-$RANDOM"
  su -c "am force-stop com.mi.health; am force-stop $PKG" 2>/dev/null
  sleep 1
  if [ -n "$lp" ] && [ -n "$lu" ]; then
    launch_app --es run_id "$run" --ez netproxy true --es launch_pkg "$lp" --es launch_uri "$lu"
  elif [ -n "$lp" ]; then
    launch_app --es run_id "$run" --ez netproxy true --es launch_pkg "$lp"
  else
    launch_app --es run_id "$run" --ez netproxy true
  fi
  wait_for "RUN $run" 25 || { warn "App 没起来"; log_dump; return 1; }
  if wait_for "netproxy 已启动|libnetproxy.so 未加载" 40; then
    log_dump | tail -8
    ok "联网网关已启动（保持连接中）"
    info "手表端发起请求后，用 miwear log 看 ch7 流量"
  else
    warn "启动失败"; log_dump; return 1
  fi
}

# ──────── auth key（从官方 App 数据库自动读）────────
save_config() { mkdir -p "$(dirname "$CONF")"; { echo "MAC=$MAC"; echo "KEY=$KEY"; echo "REPO=$REPO"; } > "$CONF"; }

# 读官方 App 的 device 表；输出: mac \t key \t model \t name（失败/无则输出空或 NONE）
read_key_from_db() {
  local dbdir=$HOME/.miwear-tmp
  mkdir -p "$dbdir"
  su -c "rm -f $dbdir/device_db*; cp /data/data/com.mi.health/databases/device_db* $dbdir/ 2>/dev/null; chmod 666 $dbdir/device_db* 2>/dev/null"
  [ -f "$dbdir/device_db" ] || { echo NODB; return 0; }
  MIWEAR_MAC="${MAC:-}" python3 - "$dbdir/device_db" <<'PY'
import sqlite3,json,sys,os
p=sys.argv[1]; want=os.environ.get('MIWEAR_MAC','').upper()
c=sqlite3.connect(p)
cols=[r[1] for r in c.execute('PRAGMA table_info(device)')]
found=[]
for row in c.execute('select * from device'):
    r=dict(zip(cols,row))
    for col in ('detail','extraValues'):
        s=r.get(col) or ''
        if 'encrypt_key' not in s: continue
        try: j=json.loads(s)
        except Exception: continue
        k=j.get('encrypt_key')
        if k: found.append((j.get('mac',''),k,r.get('model',''),(r.get('name') or '').strip()))
if not found:
    print('NONE'); raise SystemExit
pick=next((f for f in found if f[0].upper()==want), found[0])
print('%s\t%s\t%s\t%s' % pick)
PY
}

# 从已配对设备里猜手表 MAC
detect_mac() {
  su -c "dumpsys bluetooth_manager" 2>/dev/null | sed -n '/Bonded devices/,/AdapterState/p' \
    | grep -iE "watch|手环|手表" | grep -oiE "([0-9a-f]{2}:){5}[0-9a-f]{2}" | head -1
}

# 没配置时自动推导 auth key（及 MAC）
ensure_key() {
  [ -n "${MAC:-}" ] || MAC=$(detect_mac)
  [ -n "${KEY:-}" ] && return 0
  need_root
  local out; out=$(read_key_from_db)
  case "$out" in
    NODB|NONE|"") die "没找到 auth key。手动创建 $CONF（MAC=/KEY=），或跑 miwear key 看看原因" ;;
  esac
  local dmac dkey
  IFS=$'\t' read -r dmac dkey _ _ <<< "$out"
  [ -n "${MAC:-}" ] || MAC=$dmac
  KEY=$dkey
  info "已自动获取 auth key（来自小米运动健康数据库）"
  save_config
}

cmd_key() {
  need_root
  local save=0
  [ "${1:-}" = "--save" ] && save=1
  [ -n "${MAC:-}" ] || MAC=$(detect_mac)
  local out; out=$(read_key_from_db)
  case "$out" in
    NODB) die "读不到小米运动健康的 device_db（App 装了吗？）" ;;
    NONE|"") die "数据库里没找到 encrypt_key" ;;
  esac
  local mac key model name
  IFS=$'\t' read -r mac key model name <<< "$out"
  ok "auth key = $key"
  info "手表：$name ($model)   MAC=$mac"
  [ "${mac^^}" = "${MAC^^}" ] || warn "配置里的 MAC ($MAC) 与数据库 ($mac) 不一致"
  if [ $save -eq 1 ]; then MAC=$mac; KEY=$key; save_config; ok "已写入 $CONF"
  else info "加 --save 可写入 $CONF"; fi
}

# ───────── log ─────────
cmd_log() {
  need_root
  local n=60 follow=0
  while [ $# -gt 0 ]; do
    case "$1" in
      -n) n=$2; shift 2 ;;
      -f) follow=1; shift ;;
      *) shift ;;
    esac
  done
  su -c "test -f $LOG" 2>/dev/null || die "还没有日志"
  if [ $follow -eq 1 ]; then
    info "跟随日志（Ctrl-C 退出）…"
    su -c "tail -f $LOG" | sed -E 's/^(→|←) (DATA|CMD) seq=[0-9]+ ch=[0-9-]+ op=[0-9-]+ len=[0-9]+ .{60,}$/\1 \2 (帧数据略)/'
  else
    log_dump | tail -n "$n"
  fi
}

# ───────── build ─────────
token() { sed -nE 's#https://[^:]*:([^@]*)@github.com.*#\1#p' "$HOME/.git-credentials" 2>/dev/null | head -1; }
gh_api() { curl -s -m 30 -H "Authorization: token $(token)" -H "Accept: application/vnd.github+json" "$@"; }

cmd_build() {
  local kind=${1:-apk}; shift || true
  local do_install=0
  for a in "$@"; do [ "$a" = "--install" ] && do_install=1; done

  local wf artifact
  case "$kind" in
    apk) wf=build.yml;    artifact=miwear-ctl-apk ;;
    rpk) wf=quickapp.yml; artifact=quickapp-rpk ;;
    *) die "用法: miwear build apk|rpk [--install]" ;;
  esac
  local tk; tk=$(token); [ -n "$tk" ] || die "没找到 GitHub token（~/.git-credentials）"

  info "触发 $wf …"
  curl -s -m 30 -X POST -H "Authorization: token $tk" -H "Accept: application/vnd.github+json" \
    "https://api.github.com/repos/$REPO/actions/workflows/$wf/dispatches" \
    -d '{"ref":"main"}' -w "http=%{http_code}\n" -o /dev/null || die "dispatch 失败"

  info "等待构建…"
  local rid="" i s
  for i in $(seq 1 60); do
    sleep 10
    s=$(gh_api "https://api.github.com/repos/$REPO/actions/runs?per_page=5" | python3 -c "
import json,sys
d=json.load(sys.stdin)
for r in d.get('workflow_runs',[]):
    if r['path'].endswith('$wf'):
        print(r['id'], r['status'], r.get('conclusion') or '-'); break
")
    echo "  ${D}$s${N}"
    case "$s" in *completed\ success*) rid=$(echo "$s" | awk '{print $1}'); break ;;
                  *completed*) die "构建失败：https://github.com/$REPO/actions" ;;
    esac
  done
  [ -n "$rid" ] || die "构建超时"

  info "下载产物 $artifact …"
  mkdir -p "$HOME/miwear-ctl/dist"
  local aid="" i2
  for i2 in 1 2 3 4 5; do
    aid=$(gh_api "https://api.github.com/repos/$REPO/actions/runs/$rid/artifacts" \
          | python3 -c "import json,sys;a=json.load(sys.stdin)['artifacts'];print(a[0]['id'] if a else '')" 2>/dev/null)
    [ -n "$aid" ] && break
    sleep 6
  done
  [ -n "$aid" ] || die "拿不到 artifact id（构建产物可能已过期）"
  local got=0
  for i2 in 1 2 3 4 5; do
    rm -f "$TMP/art.zip"
    if curl -sL -m 300 --retry 3 --retry-delay 3 -H "Authorization: token $tk" \
         "https://api.github.com/repos/$REPO/actions/artifacts/$aid/zip" -o "$TMP/art.zip" \
       && unzip -tq "$TMP/art.zip" >/dev/null 2>&1; then got=1; break; fi
    info "下载重试 $i2 …"
    sleep 6
  done
  [ $got -eq 1 ] || die "下载产物失败（网络）"
  rm -rf "$TMP/art"; mkdir -p "$TMP/art"
  unzip -o -q "$TMP/art.zip" -d "$TMP/art" || die "解压失败"

  if [ "$kind" = rpk ]; then
    local f; f=$(find "$TMP/art" -name '*.rpk' | head -1)
    [ -n "$f" ] || die "产物里没有 rpk"
    cp "$f" "$HOME/miwear-ctl/dist/"; ok "rpk → ~/miwear-ctl/dist/$(basename "$f")"
    [ $do_install -eq 1 ] && cmd_install "$HOME/miwear-ctl/dist/$(basename "$f")"
  else
    local f; f=$(find "$TMP/art" -name '*.apk' | head -1)
    [ -n "$f" ] || die "产物里没有 apk"
    if [ $do_install -eq 1 ]; then
      need_root
      su -c "cp $(q "$f") /data/local/tmp/miwear.apk && chmod 644 /data/local/tmp/miwear.apk"
      su -c "pm install -r /data/local/tmp/miwear.apk" 2>&1 | tail -2
      su -c "pm grant $PKG android.permission.POST_NOTIFICATIONS" 2>/dev/null
      ok "APK 已安装"
    else
      ok "apk → $f"
    fi
  fi
}

# ───────── 入口 ─────────
case "${1:-}" in
  status)    shift; cmd_status "$@" ;;
  install)   shift; cmd_install "$@" ;;
  apps)      shift; cmd_apps "$@" ;;
  app)       shift; cmd_app "$@" ;;
  key)       shift; cmd_key "$@" ;;
  uninstall) shift; cmd_uninstall "$@" ;;
  launch)    shift; cmd_launch "$@" ;;
  notify)    shift; cmd_notify "$@" ;;
  info)      shift; cmd_info "$@" ;;
  find)      shift; cmd_find "$@" ;;
  msg)       shift; cmd_msg "$@" ;;
  sync)      shift; cmd_sync "$@" ;;
  raw)       shift; cmd_raw "$@" ;;
  net)       shift; cmd_net "$@" ;;
  log)       shift; cmd_log "$@" ;;
  build)     shift; cmd_build "$@" ;;
  ""|-h|--help|help) sed -n '2,25p' "$0" | sed 's/^# \{0,1\}//' ;;
  *) die "未知命令: $1（试 miwear help）" ;;
esac
